# pages/Artisan_Register_QR.py
import streamlit as st
import sqlite3
import random
import string

st.set_page_config(page_title="Artisan Registration", page_icon="🛠️")
st.title("Einst Personnel Management Services (EPMS) Ltd\nConnecting Skilled Artisans with Real Opportunities")

# --- Utility: Generate unique Artisan Code ---
def generate_artisan_code():
    prefix = "EPMS"
    suffix = ''.join(random.choices(string.ascii_uppercase + string.digits, k=8))
    return f"{prefix}-{suffix}"

# --- Capture referral code from QR URL safely ---
ref_code_from_qr = ""
params = st.experimental_get_query_params()
if "ref" in params:
    # Join all parts in case multiple values, then strip
    ref_code_from_qr = "".join(params["ref"]).strip()

# Store referral code in session
if "ref_code" not in st.session_state:
    st.session_state["ref_code"] = ref_code_from_qr

# --- Registration Form ---
with st.form("registration_form"):
    business_name = st.text_input("Business Name")
    email = st.text_input("Email Address")
    phone = st.text_input("Phone Number")
    trade = st.selectbox(
        "Trade",
        ["Plumber", "Electrician", "Cleaner", "Gas Engineer", "Handyman", "Other"]
    )
    business_address = st.text_input("Business Address")
    city_area = st.text_input("City / Area")
    postcode = st.text_input("Postcode (optional)")

    gas_safe_number = None
    if trade in ["Plumber", "Gas Engineer"]:
        gas_safe_number = st.text_input("🔥 Gas Safe Registration Number")

    # Pre-fill referral code from QR
    referral_code = st.text_input(
        "Referral Code (optional)",
        value=st.session_state.get("ref_code", "")
    )

    submitted = st.form_submit_button("Register")

    if submitted:
        # Generate Artisan Code
        artisan_code = generate_artisan_code()

        # Save to database
        conn = sqlite3.connect("jobs.db")
        c = conn.cursor()
        c.execute("""
            INSERT INTO artisans 
            (business_name, email, phone, trade, business_address, city_area, postcode, gas_safe_number, referral_code, artisan_code)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            business_name,
            email,
            phone,
            trade,
            business_address,
            city_area,
            postcode,
            gas_safe_number,
            referral_code,
            artisan_code
        ))
        conn.commit()
        conn.close()

        st.success(f"✅ Registration successful! Your Artisan Code: {artisan_code}")
